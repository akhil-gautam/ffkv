---
import '@fontsource/instrument-serif/400.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import catalog from '../../../../src/command_catalog.json';
import PlaygroundTerminal from '../components/PlaygroundTerminal.astro';
import { docsLink } from '../lib/links';
import { version, shortVersion } from '../lib/version';

const title = 'ffkv — freaking fast KV, on every core';
const description = 'ffkv is a durable, multi-core key-value datastore in Rust for caches, queues and background jobs. It speaks RESP and beat Dragonfly in all 27 matched benchmark cases.';
const commands = catalog.commands.length;

// Medians from benchmarks/results/dragonfly-vs-ffkv-2026-11-03/wave7b-analysis.json
// [label, ffkv, Dragonfly 2.0.2, Redis 8.2.1] commands per second.
const profiles = [
  { id: 'p16', label: '32 clients · pipeline 16', rows: [
    ['GET 256 B', 2941042, 2603375, 2082643], ['SET 256 B', 2634198, 2427828, 1736991],
    ['GET 4 KiB', 1840583, 1155995, 795787], ['SET 4 KiB', 1641558, 1097966, 494416],
    ['INCR', 3076196, 2971252, 2079936], ['HGET', 2826854, 2599985, 1689266],
    ['HSET', 2628055, 2447099, 1514368], ['ZADD', 2398487, 1835926, 548041],
    ['ZRANGE', 1786067, 1485170, 1094335] ] },
  { id: 'p1', label: '32 clients · no pipelining', rows: [
    ['GET 256 B', 597096, 338504, 358598], ['SET 256 B', 578372, 339073, 339196],
    ['GET 4 KiB', 546983, 301687, 282093], ['SET 4 KiB', 525455, 305616, 282125],
    ['INCR', 595150, 338542, 359802], ['HGET', 583295, 338542, 338542],
    ['HSET', 559829, 338542, 338354], ['ZADD', 432670, 320660, 237959],
    ['ZRANGE', 554188, 321313, 321805] ] },
  { id: 'c1', label: '1 client', rows: [
    ['GET 256 B', 21547, 13227, 22415], ['SET 256 B', 21388, 13114, 21929],
    ['GET 4 KiB', 20669, 12443, 21002], ['SET 4 KiB', 20419, 12512, 20954],
    ['INCR', 21468, 13342, 22365], ['HGET', 22019, 13193, 22379],
    ['HSET', 21747, 13014, 22039], ['ZADD', 21283, 12870, 21380],
    ['ZRANGE', 21025, 12862, 21856] ] },
];
const fmt = (n: number) => n >= 1e6 ? `${(n / 1e6).toFixed(2)}M` : n >= 1e4 ? `${Math.round(n / 1e3)}k` : String(n);

const docker = 'docker run -d --name ffkv -p 6379:6379 -v ffkv-data:/var/lib/ffkv ghcr.io/akhil-gautam/ffkv';
const year = 2026;

// Dark cards carry a faint field of random digits drawn as 3×5 dot-matrix glyphs,
// like a memory dump. One tile, regenerated per build, repeated as a background.
const GLYPHS = ['111101101101111', '010110010010111', '111001111100111', '111001111001111', '101101111001001', '111100111001111', '111100111101111', '111001001001001', '111101111101111', '111101111001111'];
const pitch = 3.4, cellW = 17, cellH = 24, tileCols = 28, tileRows = 12;
const glyphDefs = GLYPHS.map((bits, digit) => `<g id="g${digit}">${[...bits].map((bit, i) => bit === '1' ? `<circle cx="${(i % 3) * pitch}" cy="${Math.floor(i / 3) * pitch}" r="1"/>` : '').join('')}</g>`).join('');
const cells: string[] = [];
for (let row = 0; row < tileRows; row++) for (let col = 0; col < tileCols; col++) {
  if (Math.random() < 0.18) continue; // gaps keep it from reading as a solid wall
  const tone = Math.random();
  const fill = tone < 0.04 ? '%23f6c26b' : tone < 0.12 ? '%23b9e38f' : '%23ffffff';
  const alpha = tone < 0.12 ? 0.5 : 0.1 + Math.random() * 0.08;
  cells.push(`<use href="%23g${Math.floor(Math.random() * 10)}" x="${col * cellW + 4}" y="${row * cellH + 5}" fill="${fill}" fill-opacity="${alpha.toFixed(2)}"/>`);
}
const digitTile = `url("data:image/svg+xml,${`<svg xmlns='http://www.w3.org/2000/svg' width='${tileCols * cellW}' height='${tileRows * cellH}'><defs>${glyphDefs}</defs>${cells.join('')}</svg>`.replace(/"/g, "'").replace(/</g, '%3C').replace(/>/g, '%3E')}")`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href={docsLink('favicon.svg')} type="image/svg+xml" />
  <link rel="canonical" href={new URL(import.meta.env.BASE_URL, Astro.site)} />
</head>
<body style={`--digits: ${digitTile}`}>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav-wrap">
    <nav class="nav" aria-label="Primary">
      <a class="brand" href={docsLink('')} aria-label="ffkv home">
        <svg viewBox="0 0 202 88" width="62" height="27" fill="currentColor" aria-hidden="true"><g transform="translate(12 12)"><path d="M0 64V20C0 9 9 0 20 0H36L26 12H20C15.6 12 12 15.6 12 20V28H32L22 40H12V64Z"/><path d="M36 64V20C36 9 45 0 56 0H72L62 12H56C51.6 12 48 15.6 48 20V28H68L58 40H48V64Z"/><path d="M78 0H90V35L106 20H123L101 41L124 64H106L90 47V64H78Z"/><path d="M128 20H141L153 50L165 20H178L160 64H146Z"/></g></svg>
      </a>
      <div class="nav-links">
        <a href={docsLink('getting-started/quickstart/')}>Docs</a>
        <a href={docsLink('reference/commands/')}>Commands</a>
        <a href={docsLink('playground/')}>Playground</a>
        <a href="#benchmarks">Benchmarks</a>
        <a href={docsLink('deployment/docker/')}>Docker</a>
      </div>
      <a class="btn btn-dark nav-cta" href={docsLink('getting-started/quickstart/')}>Get started</a>
    </nav>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <canvas class="hero-art" aria-hidden="true"></canvas>
      <div class="hero-inner">
        <div class="hero-main">
          <p class="pill rise" style="--d:0"><span class="dot" aria-hidden="true"></span> ffkv {shortVersion} · open alpha · written in Rust</p>
          <h1 id="hero-title"><span class="rise" style="--d:1">Freaking fast KV,</span><br /><em class="rise" style="--d:2">on every core.</em></h1>
          <p class="lead rise" style="--d:3">ffkv is a durable key-value datastore for caches, queues and background jobs. Connections spread across every CPU core, and it speaks RESP, so the clients you already use connect as they are.</p>
          <div class="hero-actions rise" style="--d:4">
            <a class="btn btn-dark btn-lg" href={docsLink('getting-started/quickstart/')}>Start building <span aria-hidden="true">→</span></a>
            <a class="btn btn-soft btn-lg" href="#benchmarks">See benchmarks</a>
          </div>
        </div>
        <div class="cores rise" style="--d:3" aria-hidden="true">
          <div class="cores-head"><span><i class="live"></i> ffkv · 4 cores</span><span class="mono">0.0.0.0:6379</span></div>
          {[0, 1, 2, 3].map((core) => <div class="core">
            <span class="core-label">core {core}</span>
            <div class="track">
              {[['GET', 'INCR', 'HSET'], ['LPUSH', 'GET', 'ZADD'], ['SET', 'BRPOP', 'GET'], ['INCR', 'HGET', 'XADD']][core].map((name, i) =>
                <span class="packet" style={`--i:${i};--c:${core}`}>{name}</span>)}
            </div>
          </div>)}
          <div class="cores-foot"><span>INCR <b>3.08M/s</b></span><span>vs Dragonfly <b>27/27</b></span></div>
        </div>
        <div class="copy-line rise" style="--d:5" data-copy={docker}>
          <span class="prompt" aria-hidden="true">$</span>
          <code>{docker}</code>
          <button type="button" class="copy" aria-label="Copy docker command">Copy</button>
        </div>
      </div>
    </section>

    <!-- Works with -->
    <section class="works" aria-label="Compatible clients">
      <p>Drop-in for the tools you already run</p>
      <div class="marquee">
        <ul>
          <li>RESP2</li><li>RESP3</li><li>redis-cli</li><li>Sidekiq</li><li>Rails cache</li><li>Lua scripts</li><li>TLS + ACL</li><li>MCP agents</li><li>Prometheus</li><li>Docker</li>
        </ul>
        <ul aria-hidden="true">
          <li>RESP2</li><li>RESP3</li><li>redis-cli</li><li>Sidekiq</li><li>Rails cache</li><li>Lua scripts</li><li>TLS + ACL</li><li>MCP agents</li><li>Prometheus</li><li>Docker</li>
        </ul>
      </div>
    </section>

    <!-- Stat band -->
    <section class="stats reveal" aria-label="At a glance">
      <div><strong><span class="count" data-to="27">27</span><span class="sep">/</span>27</strong><p>matched benchmark cases<br />faster than Dragonfly</p></div>
      <div><strong><span class="count" data-to="3.08" data-decimals="2">3.08</span>M</strong><p>INCR per second on<br />four server cores</p></div>
      <div><strong><span class="count" data-to={commands}>{commands}</span></strong><p>commands, plus 19<br />data-type families</p></div>
    </section>

    <!-- Lanes race -->
    <section class="race" aria-labelledby="race-title">
      <div class="race-card reveal">
        <div class="race-copy">
          <p class="race-kicker">GET 256 B · 32 clients · no pipelining</p>
          <h2 id="race-title">Requests run on <em>every core</em></h2>
          <dl class="race-nums">
            <div class="is-ffkv"><dt>ffkv</dt><dd><span class="count" data-to="597">597</span>k<small>/s</small></dd></div>
            <div><dt>Redis 8.2.1</dt><dd>359k<small>/s</small></dd></div>
            <div><dt>Dragonfly 2.0.2</dt><dd>339k<small>/s</small></dd></div>
          </dl>
          <p class="race-ratio"><b>1.67×</b> Redis <span aria-hidden="true">·</span> <b>1.76×</b> Dragonfly</p>
        </div>
        <div class="race-tracks" aria-hidden="true">
          <div class="group single">
            <div class="group-head"><span>Single thread</span><span>1 lane · requests wait their turn</span></div>
            <div class="lane">
              <div class="queue">{[0, 1, 2, 3, 4, 5].map((n) => <i style={`--n:${n}`}></i>)}</div>
              <div class="road">{['GET', 'SET', 'INCR', 'GET'].map((name, n) => <span class="car" style={`--n:${n}`}>{name}</span>)}</div>
            </div>
          </div>
          <div class="group multi">
            <div class="group-head"><span>ffkv</span><span>a lane per core · no waiting</span></div>
            {[0, 1, 2, 3].map((lane) => <div class="lane">
              <div class="queue empty"></div>
              <div class="road">{[['GET', 'HSET'], ['INCR', 'GET'], ['SET', 'LPUSH'], ['GET', 'ZADD']][lane].map((name, n) => <span class="car" style={`--n:${n};--l:${lane}`}>{name}</span>)}</div>
            </div>)}
          </div>
        </div>
      </div>
      <p class="race-caption">Commands on one core take turns. ffkv gives each CPU its own runtime and runs shard work where the request lands, so requests travel side by side, and a hot key is batched on its shard's worker instead of bouncing between cores.</p>
    </section>

    <!-- Benchmarks -->
    <section class="bench" id="benchmarks" aria-labelledby="bench-title">
      <div class="section-head">
        <h2 id="bench-title" class="reveal">ffkv vs Dragonfly <em>vs Redis</em></h2>
        <p>Same VM, same pinned CPUs, same compiled <code>redis-benchmark</code>. Commands per second, median of two runs, every trial checked for correctness.</p>
      </div>
      <div class="tabs" role="tablist" aria-label="Client profile">
        {profiles.map((p, i) => <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{p.label}</button>)}
      </div>
      <div class="legend" aria-hidden="true"><span class="k ffkv"></span>ffkv <span class="k dfly"></span>Dragonfly 2.0.2 <span class="k redis"></span>Redis 8.2.1</div>
      {profiles.map((p, i) => {
        const max = Math.max(...p.rows.flatMap((r) => r.slice(1) as number[]));
        return <div class="panel" role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
          <table>
            <caption class="sr-only">Commands per second, {p.label}</caption>
            <thead class="sr-only"><tr><th scope="col">Workload</th><th scope="col">ffkv</th><th scope="col">Dragonfly</th><th scope="col">Redis</th></tr></thead>
            <tbody>
              {p.rows.map(([name, f, d, r]) => <tr>
                <th scope="row">{name}<span class="ratio">{((f as number) / (d as number)).toFixed(2)}× Dragonfly</span></th>
                <td colspan="3"><div class="bars">
                  <div class="bar ffkv" style={`--w:${((f as number) / max) * 100}%`}><span>{fmt(f as number)}</span></div>
                  <div class="bar dfly" style={`--w:${((d as number) / max) * 100}%`}><span>{fmt(d as number)}</span></div>
                  <div class="bar redis" style={`--w:${((r as number) / max) * 100}%`}><span>{fmt(r as number)}</span></div>
                </div></td>
              </tr>)}
            </tbody>
          </table>
        </div>;
      })}
      <p class="bench-note">ffkv beat Dragonfly in 27 of 27 cases and Redis in 18 of 27. With a single client and no pipelining, single-threaded Redis stays 0.5–4% ahead. Memory-only, one ARM64 Linux VM, four server CPUs. <a href={docsLink('contributing/benchmarks/')}>Method, every table and raw data →</a></p>
    </section>

    <!-- Three things -->
    <section class="three" aria-labelledby="three-title">
      <h2 id="three-title" class="reveal">Built for <em>background jobs</em></h2>
      <div class="three-grid">
        <article class="pcard amber reveal" style="--d:0">
          <div class="mini">
            <div class="row"><span class="mono muted">--durability</span><span class="seg"><b>strict</b><i>everysec</i></span></div>
            <div class="row log"><span class="mono">fsync</span><span>SET order:42 …</span><span class="ok">✓</span></div>
            <div class="row log"><span class="mono">fsync</span><span>LPUSH jobs …</span><span class="ok">✓</span></div>
            <div class="chips"><span>WAL</span><span>Checkpoints</span><span>Backups</span></div>
          </div>
          <span class="tag">DURABLE</span>
          <h3>Durable when you ask for it</h3>
          <p><code>strict</code> fsyncs before every reply; <code>everysec</code> trades up to about a second of writes for speed. Plus online backups and offline restore.</p>
        </article>
        <article class="pcard lime reveal" style="--d:1">
          <div class="mini">
            <div class="row"><span class="mono">BRPOP jobs 0</span><span class="muted">waiting…</span></div>
            <div class="row job"><span class="avatar">J</span><span><b>email.welcome</b><small>leased · 30s</small></span><span class="btn-mini">ACK</span></div>
            <div class="row job"><span class="avatar">J</span><span><b>invoice.render</b><small>retry 1 of 5</small></span><span class="btn-mini ghost">NACK</span></div>
          </div>
          <span class="tag">QUEUES</span>
          <h3>Queues without bolt-ons</h3>
          <p>Blocking list queues, native leased jobs with acknowledgements and retries, and a Sidekiq integration that is tested.</p>
        </article>
        <article class="pcard sky reveal" style="--d:2">
          <div class="mini">
            <div class="row"><span class="mono">TLS</span><span class="toggle on"></span></div>
            <div class="row"><span class="mono">ACL users</span><span class="toggle on"></span></div>
            <div class="row"><span class="mono">Prometheus</span><span class="toggle on"></span></div>
            <div class="chips"><span>Console</span><span>Replication</span><span>Cluster</span></div>
          </div>
          <span class="tag">OPERABLE</span>
          <h3>Built to be operated</h3>
          <p>TLS, named users, metrics, an audited web console, native replication and cluster mode.</p>
        </article>
      </div>
    </section>

    <!-- Dark feature cards -->
    <section class="dark" aria-labelledby="dark-title">
      <div class="section-head light">
        <h2 id="dark-title">The full Redis <em>toolbox</em></h2>
        <p>{commands} commands across 19 data-type families, from strings and streams to JSON, vector sets and time series.</p>
      </div>
      <div class="dgrid">
        <article class="dcard reveal" style="--d:0">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 8 9-5 9 5-9 5-9-5Zm0 5 9 5 9-5"/></svg>
          <h3>19 data types</h3><p>Probabilistic sketches, JSON, vectors.</p>
          <div class="chat"><span class="q">JSON.SET user:1 $ '…'</span><span class="a">OK</span><span class="q">BF.ADD seen ada</span><span class="a">(integer) 1</span></div>
        </article>
        <article class="dcard reveal" style="--d:1">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6 3 12l5 6m8-12 5 6-5 6"/></svg>
          <h3>Lua & transactions</h3><p>EVAL, FUNCTION, MULTI/EXEC, WATCH.</p>
          <div class="chat"><span class="q">EVAL "return redis.call('INCR',KEYS[1])" 1 hits</span><span class="a">(integer) 7</span></div>
        </article>
        <article class="dcard reveal" style="--d:2">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 16 0M8 12a4 4 0 0 1 8 0"/><circle cx="12" cy="12" r="1"/></svg>
          <h3>Pub/Sub</h3><p>Channels, patterns, shard channels.</p>
          <div class="chat"><span class="q">PUBLISH orders paid:42</span><span class="a">(integer) 3</span></div>
        </article>
        <article class="dcard reveal" style="--d:3">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4v10a4 4 0 0 0 4 4h8M14 14l4 4-4 4"/><circle cx="6" cy="4" r="2"/></svg>
          <h3>Replication & cluster</h3><p>Native replicas, hash-slot clustering.</p>
          <div class="chat"><span class="q">REPLICAOF ffkv-1 6379</span><span class="a">OK</span></div>
        </article>
        <article class="dcard reveal" style="--d:4">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v4m0 10v4M3 12h4m10 0h4M6 6l2.5 2.5m7 7L18 18M6 18l2.5-2.5m7-7L18 6"/></svg>
          <h3>MCP for agents</h3><p>A sidecar for Claude, Codex and friends.</p>
          <div class="chat"><span class="q">ffkv-mcp --port 6379</span><span class="a">7 tools ready</span></div>
        </article>
      </div>
    </section>

    <!-- Try it in the browser -->
    <section class="try" aria-labelledby="try-title">
      <div class="try-copy">
        <h2 id="try-title">Try it in <em>your browser</em></h2>
        <p>This terminal runs ffkv's real command engine in your browser via WebAssembly. In-memory only; Lua, persistence, replication and networking aren't available here.</p>
        <p class="try-label">Run one of these, or type your own:</p>
        <div class="try-chips">
          {['SET greeting "hello ffkv"', 'GET greeting', 'INCR visits', 'LPUSH jobs email.welcome', 'ZADD board 120 ada 95 linus', 'ZREVRANGE board 0 -1 WITHSCORES'].map((command) =>
            <button type="button" data-ffkv-run="home" data-command={command}>{command}</button>)}
        </div>
        <a class="btn btn-dark btn-lg" href={docsLink('playground/')}>Open the playground <span aria-hidden="true">→</span></a>
        <p class="try-note">Two terminals sharing one dataset, with guided examples for queues, streams and Pub/Sub.</p>
      </div>
      <PlaygroundTerminal name="home" label="ffkv-cli in your browser" size="compact" />
    </section>

    <!-- Get started -->
    <section class="start" aria-labelledby="start-title">
      <div class="steps">
        <h2 id="start-title">Try it with <em>Docker</em></h2>
        <ol>
          <li><b>Start it</b><span>The image runs on amd64 and arm64. TLS and an <code>admin</code> password are generated on first start.</span></li>
          <li><b>Talk to it</b><span>Use <code>ffkv-cli</code> inside the container, or any Redis client with the generated CA.</span></li>
          <li><b>Keep it</b><span>Data, certificate and password live in the volume, and <code>strict</code> durability is the default.</span></li>
        </ol>
        <a class="btn btn-dark btn-lg" href={docsLink('deployment/docker/')}>Read the Docker guide <span aria-hidden="true">→</span></a>
      </div>
      <div class="term reveal" role="img" aria-label="Terminal session starting ffkv with Docker">
        <div class="term-bar"><i></i><i></i><i></i><span>zsh</span></div>
<pre><span class="tl type" style="--t:0"><span class="c">$</span> docker run -d --name ffkv -p 6379:6379 \</span>
<span class="tl type" style="--t:1">    -v ffkv-data:/var/lib/ffkv ghcr.io/akhil-gautam/ffkv</span>
<span class="tl" style="--t:2"><span class="m">ffkv {version} listening on 0.0.0.0:6379 (WAL Strict)</span></span>

<span class="tl type" style="--t:3"><span class="c">$</span> docker exec ffkv ffkv-cli PING</span>
<span class="tl" style="--t:4"><span class="g">PONG</span></span>

<span class="tl type" style="--t:5"><span class="c">$</span> docker exec ffkv ffkv-cli SET greeting "hello ffkv"</span>
<span class="tl" style="--t:6"><span class="g">OK</span></span>

<span class="tl type" style="--t:7"><span class="c">$</span> docker exec ffkv ffkv-cli INCR visits</span>
<span class="tl" style="--t:8"><span class="g">(integer) 1</span><span class="caret" aria-hidden="true"></span></span></pre>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta" aria-labelledby="cta-title">
      <h2 id="cta-title" class="reveal">Read the docs <em>before you deploy</em></h2>
      <p>Every guarantee and limit is written down: durability, compatibility, and what isn't production-certified yet.</p>
      <div class="hero-actions center">
        <a class="btn btn-dark btn-lg" href={docsLink('getting-started/quickstart/')}>Read the handbook <span aria-hidden="true">→</span></a>
        <a class="btn btn-soft btn-lg" href={docsLink('concepts/compatibility/')}>Compatibility contract</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <canvas class="foot-art" aria-hidden="true"></canvas>
    <div class="foot-inner">
      <div class="foot-brand">
        <svg viewBox="0 0 202 88" width="120" height="52" fill="currentColor" aria-hidden="true"><g transform="translate(12 12)"><path d="M0 64V20C0 9 9 0 20 0H36L26 12H20C15.6 12 12 15.6 12 20V28H32L22 40H12V64Z"/><path d="M36 64V20C36 9 45 0 56 0H72L62 12H56C51.6 12 48 15.6 48 20V28H68L58 40H48V64Z"/><path d="M78 0H90V35L106 20H123L101 41L124 64H106L90 47V64H78Z"/><path d="M128 20H141L153 50L165 20H178L160 64H146Z"/></g></svg>
        <p>freaking fast KV<br />© {year} ffkv · open alpha</p>
      </div>
      <div class="foot-cols">
