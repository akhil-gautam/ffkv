  <script>
    import { startDotArt } from '../lib/dot-art';
    for (const line of document.querySelectorAll<HTMLElement>('.copy-line')) {
      const button = line.querySelector('button');
      button?.addEventListener('click', async () => {
        await navigator.clipboard.writeText(line.dataset.copy ?? '');
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy'; }, 1600);
      });
    }
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const grow = (panel: HTMLElement | null) => {
      if (!panel) return;
      panel.classList.remove('grown');
      requestAnimationFrame(() => requestAnimationFrame(() => panel.classList.add('grown')));
    };
    const select = (tab: HTMLButtonElement) => {
      for (const other of tabs) {
        const on = other === tab;
        other.setAttribute('aria-selected', String(on));
        other.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(other.getAttribute('aria-controls')!)!;
        panel.hidden = !on;
        if (on) grow(panel);
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next); next.focus();
      });
    });
    const header = document.querySelector('.nav-wrap');
    const onScroll = () => header?.classList.toggle('floating', window.scrollY > 24);
    window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

    // Scroll-triggered motion; everything stays visible without JS or with reduced motion.
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add(still ? 'still' : 'motion');
    const countUp = (el: HTMLElement) => {
      const to = Number(el.dataset.to), decimals = Number(el.dataset.decimals ?? 0), start = performance.now();
      const frame = (now: number) => {
        const t = Math.min(1, (now - start) / 1400), eased = 1 - Math.pow(1 - t, 3);
        el.textContent = (to * eased).toFixed(decimals);
        if (t < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    };
    const seen = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        el.classList.add('in');
        if (!still) el.querySelectorAll<HTMLElement>('.count').forEach(countUp);
        if (el.classList.contains('panel')) grow(el);
        seen.unobserve(el);
      }
    }, { threshold: 0.18 });
    document.querySelectorAll('.reveal, .panel:not([hidden])').forEach((el) => seen.observe(el));

    const heroArt = document.querySelector<HTMLCanvasElement>('.hero-art');
    const footArt = document.querySelector<HTMLCanvasElement>('.foot-art');
    if (heroArt) startDotArt(heroArt, 'swarm');
    if (footArt) startDotArt(footArt, 'persist');
  </script>
