---
import { Code } from '@astrojs/starlight/components';
import catalog from '../../../../src/command_catalog.json';
import { docsLink } from '../lib/links';

const paths = [
  { number: '01', icon: 'terminal', title: 'Make your first connection', text: 'Build the binaries, start an isolated instance, and get to your first PONG.', label: 'Quickstart', href: 'getting-started/quickstart/' },
  { number: '02', icon: 'command', title: 'Find the right command', text: 'Search the pinned catalog. Read the syntax, inspect the arguments, and see behavior examples.', label: 'Command reference', href: 'reference/commands/' },
  { number: '03', icon: 'layers', title: 'Choose your data model', text: 'From strings and lists to JSON, time series, vectors, and probabilistic structures.', label: 'Explore data types', href: 'data-types/' },
  { number: '04', icon: 'queue', title: 'Put work on a queue', text: 'Use familiar Redis lists, connect Sidekiq, or build workers with native leased jobs.', label: 'Native job queues', href: 'guides/native-jobs/' },
  { number: '05', icon: 'shield', title: 'Understand what persists', text: 'Choose a durability policy, inspect recovery rules, and practice a safe backup restore.', label: 'Persistence & recovery', href: 'operations/persistence/' },
  { number: '06', icon: 'window', title: 'See your instance clearly', text: 'Open the React console with real credentials, bounded reads, and audited operator actions.', label: 'Console guide', href: 'getting-started/console/' },
];
const icons: Record<string, string> = {
  terminal: 'm6 8 4 4-4 4m7 1h5M4 4h16v16H4z',
  command: 'M9 7V5a2 2 0 1 0-2 2h10a2 2 0 1 0-2-2v14a2 2 0 1 0 2-2H7a2 2 0 1 0 2 2V7',
  layers: 'm3 8 9-5 9 5-9 5-9-5Zm0 5 9 5 9-5M3 18l9 5 9-5',
  queue: 'M5 5h14M5 12h10M5 19h7m5-3 3 3-3 3M2 5h.01M2 12h.01M2 19h.01',
  shield: 'M12 3 4 6v6c0 4 4 7 8 9 4-2 8-5 8-9V6l-8-3Zm-4 9 3 3 5-6',
  window: 'M3 4h18v16H3zM3 9h18M8 9v11M6 6.5h.01M9 6.5h.01',
};
const session = `target/release/ffkv-cli -p 6382 PING\n# PONG\n\ntarget/release/ffkv-cli -p 6382 SET hello "ffkv"\n# OK\n\ntarget/release/ffkv-cli -p 6382 GET hello\n# ffkv`;
const start = `cargo build --release --bins\ntarget/release/ffkv --bind 127.0.0.1:6382 \\\n  --data-dir ./ffkv-docs-data --durability strict`;
---
<div class="landing">
  <section class="landing-hero" aria-labelledby="_top">
    <div class="hero-copy">
      <div class="hero-eyebrow"><span class="live-mark" aria-hidden="true"></span> THE FFKV HANDBOOK <span class="hero-edition">/ 0.1.0 ALPHA</span></div>
      <h1 id="_top">Build fast.<br /><span>Operate with clarity.</span></h1>
      <p class="hero-lead">Your guide to <strong>freaking fast KV</strong>. A Redis-compatible datastore built in Rust, with familiar commands and explicit contracts for the data you care about.</p>
      <div class="hero-actions">
        <a class="docs-button primary" href={docsLink('getting-started/quickstart/')}>Start building <span aria-hidden="true">↗</span></a>
        <a class="docs-button secondary" href={docsLink('reference/commands/')}>Explore commands <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-contract"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 10 4 4 8-9"/></svg> Your protocol. Our engine. No Redis server required.</div>
    </div>
    <div class="hero-terminal">
      <div class="terminal-caption"><span><span aria-hidden="true">›_</span> SAME WIRE. NEW ENGINE.</span><span>127.0.0.1:6382</span></div>
      <Code code={session} lang="sh" title="A familiar first conversation" />
      <div class="terminal-foot"><span class="live-mark" aria-hidden="true"></span> RESP2 & RESP3 <span class="terminal-divider">/</span> Native ffkv-cli included</div>
    </div>
  </section>

  <div class="capability-strip" aria-label="Product scope">
    <div><strong>{catalog.commands.length}</strong><span>catalog commands</span></div>
    <div><strong>19</strong><span>data-type families</span></div>
    <div><strong>Rust <span class="plus">+</span> Tokio</strong><span>sharded actor execution</span></div>
    <a href={docsLink('concepts/compatibility/')}><span class="scope-label">Know the scope</span><span>Read the compatibility contract <span aria-hidden="true">↗</span></span></a>
  </div>

  <section class="learning-section" aria-labelledby="learn-title">
    <div class="section-kicker">A GOOD PLACE TO BEGIN</div>
    <div class="section-heading"><h2 id="learn-title">Less searching. More building.</h2><p>Follow a path, or go straight to the details.</p></div>
    <div class="learning-grid">
      {paths.map((path) => <a class="learning-card" href={docsLink(path.href)}>
        <div class="card-top"><svg viewBox="0 0 24 26" width="25" height="27" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[path.icon]}/></svg><span>{path.number}</span></div>
        <h3>{path.title}</h3><p>{path.text}</p><div class="card-link">{path.label}<span aria-hidden="true">→</span></div>
      </a>)}
    </div>
  </section>

  <section class="start-section" aria-labelledby="start-title">
    <div><div class="section-kicker">LOCAL FIRST. CLI FIRST.</div><h2 id="start-title">A fresh instance.<br />A clean starting point.</h2><p>Run these commands from the repository root. Port 6382 and a separate data directory keep this example away from an existing instance.</p><a class="text-link" href={docsLink('getting-started/installation/')}>Check prerequisites and installation <span aria-hidden="true">→</span></a></div>
    <Code code={start} lang="sh" title="Terminal 1 · start ffkv" />
  </section>

  <section class="contract-note" aria-labelledby="contract-title">
    <svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 3 9 4v5c0 4-4 7-9 9-5-2-9-5-9-9V7l9-4Zm0 5v5m0 3h.01"/></svg>
    <div><h2 id="contract-title">Compatible does not mean identical.</h2><p>The Redis 8.10 catalog is the command baseline, not a claim of exhaustive upstream parity or production HA certification. Native modules use an explicit subset; the cluster bus is ffkv-specific.</p><a href={docsLink('concepts/compatibility/')}>Read the guarantees and limits <span aria-hidden="true">→</span></a></div>
  </section>
</div>
